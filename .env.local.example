# Copy to .env.local (gitignored) and restart `npm run dev`.
# Local stack: run `npm run db:start`, then copy "API URL" and "Publishable key" from `npm run db:status`.
# Both values are PUBLIC (they ship to the browser). Never put a service_role / sb_secret_ key in any VITE_ variable.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=
